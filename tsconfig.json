{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@finance-platform/config-typescript": ["packages/config-typescript"],
      "@finance-platform/config-eslint": ["packages/config-eslint"],
      "@finance-platform/shared-types": ["packages/shared-types/src"],
      "@finance-platform/finance": ["packages/finance"],
      "@finance-platform/connectors": ["packages/connectors"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next"]
}
