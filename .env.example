# Finance Intelligence Platform — Environment Configuration
# Copy this to .env and fill in your values
# Required keys are marked with [REQUIRED], optional with [OPTIONAL]

# ─── CORE INFRASTRUCTURE ─────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./local.db          # [REQUIRED] Use postgresql://user:pass@host/db for production
JWT_SECRET=generate-a-64-char-hex-with-python-secrets-token_hex-32
ENV=local                                  # local | staging | production

# ─── MARKET DATA (Real-time prices, earnings, fundamentals) ──────────────────
FINNHUB_API_KEY=                           # [REQUIRED] https://finnhub.io — free tier: 60 calls/min
FMP_API_KEY=                               # [OPTIONAL] https://financialmodelingprep.com — IPO fallback
ALPHA_VANTAGE_KEY=                         # [OPTIONAL] https://www.alphavantage.co — backup market data

# ─── GOVERNMENT & POLITICAL DATA ─────────────────────────────────────────────
SEC_USER_AGENT=YourName your@email.com     # [REQUIRED] SEC EDGAR requires identification
CONGRESS_API_KEY=                          # [OPTIONAL] https://api.congress.gov — improves rate limits
FEC_API_KEY=                               # [OPTIONAL] https://api.open.fec.gov
OPENSECRETS_API_KEY=                       # [OPTIONAL] https://www.opensecrets.org/api
GOVINFO_API_KEY=                           # [OPTIONAL] https://api.govinfo.gov
SAM_API_KEY=                               # [OPTIONAL] https://sam.gov — government contracts
REGULATIONS_GOV_API_KEY=                   # [OPTIONAL] https://api.regulations.gov

# ─── ECONOMIC DATA ───────────────────────────────────────────────────────────
FRED_API_KEY=                              # [REQUIRED] https://fred.stlouisfed.org — GDP, CPI, rates

# ─── NEWS & MEDIA ────────────────────────────────────────────────────────────
NEWSAPI_KEY=                               # [OPTIONAL] https://newsapi.org — M&A rumors
NEWS_API_KEY=                              # [OPTIONAL] Alias for NEWSAPI_KEY
GUARDIAN_API_KEY=                          # [OPTIONAL] https://open-platform.theguardian.com
NYT_API_KEY=                              # [OPTIONAL] https://developer.nytimes.com

# ─── LEGAL & COMPLIANCE ──────────────────────────────────────────────────────
COURTLISTENER_API_KEY=                     # [OPTIONAL] https://www.courtlistener.com — litigation data
COURTLISTENER_API_TOKEN=                   # [OPTIONAL] Alias
SANCTIONS_API_KEY=                         # [OPTIONAL] Sanctions screening

# ─── AI / LLM ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=                            # [OPTIONAL] GPT-4 for analysis generation
ANTHROPIC_API_KEY=                         # [OPTIONAL] Claude for analysis generation
ANTHROPIC_MODEL=claude-sonnet-4-6         # Model to use

# ─── DEEP RESEARCH ───────────────────────────────────────────────────────────
APIFY_API_TOKEN=                           # [OPTIONAL] https://apify.com — web scraping actors
APOLLO_API_KEY=                            # [OPTIONAL] https://apollo.io — people data
LDA_API_KEY=                               # [OPTIONAL] Senate lobbying disclosure

# ─── INTERNATIONAL ───────────────────────────────────────────────────────────
UK_COMPANIES_HOUSE_KEY=                    # [OPTIONAL] https://developer.company-information.service.gov.uk
OPENCORPORATES_API_KEY=                    # [OPTIONAL] https://opencorporates.com
ALEPH_API_KEY=                             # [OPTIONAL] https://aleph.occrp.org — OCCRP data

# ─── CRYPTO ──────────────────────────────────────────────────────────────────
COINGECKO_API_KEY=                         # [OPTIONAL] https://www.coingecko.com/api
ETHERSCAN_API_KEY=                         # [OPTIONAL] https://etherscan.io

# ─── PAYMENTS (Not yet active) ───────────────────────────────────────────────
STRIPE_PUBLIC_KEY=                         # [FUTURE] Stripe publishable key
STRIPE_SECRET_KEY=                         # [FUTURE] Stripe secret key
STRIPE_WEBHOOK_SECRET=                     # [FUTURE] Stripe webhook signing secret

# ─── NOTIFICATIONS (Not yet active) ──────────────────────────────────────────
SENDGRID_API_KEY=                          # [FUTURE] Email notifications
TWILIO_ACCOUNT_SID=                        # [FUTURE] SMS alerts
TWILIO_AUTH_TOKEN=                         # [FUTURE] SMS alerts
TWILIO_PHONE_NUMBER=                       # [FUTURE] SMS sender number

# ─── FRONTEND ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001   # [REQUIRED] API URL for frontend
REACT_APP_API_URL=http://localhost:3001    # [REQUIRED] Alias

# ─── SEARCH (Optional — enhances RAG) ────────────────────────────────────────
OPENSEARCH_URL=                            # [OPTIONAL] OpenSearch/Elasticsearch URL
OPENSEARCH_INDEX=                          # [OPTIONAL] Index name

# ─── OBSERVABILITY ────────────────────────────────────────────────────────────
SENTRY_DSN=                                # [OPTIONAL] Sentry DSN for error reporting

# ─── RATE LIMITING ───────────────────────────────────────────────────────────
RATE_LIMIT=on                              # on | off — disable for development
REDIS_URL=redis://127.0.0.1:6379/0
